model Bond {
  id                    String    @id @default(cuid())
  figi                  String?
  ticker                String?
  classCode             String?
  isin                  String?
  lot                   Int?
  currency              String?

  klong                 Json?
  kshort                Json?
  dlong                 Json?
  dshort                Json?
  dlongMin              Json?
  dshortMin             Json?

  shortEnabledFlag      Boolean?
  name                  String?
  exchange              String?
  couponQuantityPerYear Int?
  maturityDate          DateTime?
  nominal               Json?
  initialNominal        Json?
  stateRegDate          DateTime?
  placementDate         DateTime?
  placementPrice        Json?
  aciValue              Json?

  countryOfRisk         String?
  countryOfRiskName     String?
  sector                String?
  issueKind             String?
  issueSize             Int?
  issueSizePlan         Int?
  tradingStatus         Int?
  otcFlag               Boolean?
  buyAvailableFlag      Boolean?
  sellAvailableFlag     Boolean?
  floatingCouponFlag    Boolean?
  perpetualFlag         Boolean?
  amortizationFlag      Boolean?

  minPriceIncrement     Json?
  apiTradeAvailableFlag Boolean?
  uid                   String    @unique
  realExchange          Int?
  positionUid           String?
  assetUid              String?

  forIisFlag            Boolean?
  forQualInvestorFlag   Boolean?
  weekendFlag           Boolean?
  blockedTcaFlag        Boolean?
  subordinatedFlag      Boolean?
  liquidityFlag         Boolean?

  first_1minCandleDate  DateTime?
  first_1dayCandleDate  DateTime?

  riskLevel             Int?
  brand                 Json?
  bondType              Int?
  callDate              DateTime?
  dlongClient           Json?
  dshortClient          Json?

  lastPrice             Json?
  coupons               Json      @default("[]")

  yield                 Float?
}
